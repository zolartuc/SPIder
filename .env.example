# Copy this file to .env and edit. Every setting is optional.

# --- Watchtower (network scanner) ---
# Subnet to scan. Leave blank to auto-detect (assumes a /24 around this machine's IP).
SPIDER_SUBNET=
# Seconds between scans.
SPIDER_SCAN_INTERVAL=300
# auto | arp | ping   (auto = raw ARP via scapy, falls back to ping sweep + ARP table)
SPIDER_SCAN_METHOD=auto
# Minutes a device can go unseen before it's marked offline.
SPIDER_OFFLINE_AFTER_MINUTES=15

# --- Alerts (optional) ---
# Push notifications via ntfy (https://ntfy.sh or self-hosted). Leave topic blank to disable.
SPIDER_NTFY_URL=https://ntfy.sh
SPIDER_NTFY_TOPIC=

# --- Pi-hole (optional) ---
# Base URL of your Pi-hole, e.g. http://192.168.1.2
SPIDER_PIHOLE_URL=
# Pi-hole v6: an "app password" (Settings > Web interface / API). Pi-hole v5: the API token.
SPIDER_PIHOLE_PASSWORD=

# --- System changes ---
# Let the Settings page change the Pi's hostname, timezone and network directly.
# Needs SPIder running on the Pi itself (not in Docker) as root. When off, SPIder
# saves the setting and shows you the commands to run instead.
SPIDER_ALLOW_SYSTEM_CHANGES=false

# Everything else (scanning, Pi-hole, alerts) can also be changed from the
# Settings page once you've signed in as an admin. Values saved there win over this file.

# --- Web dashboard ---
SPIDER_HOST=0.0.0.0
SPIDER_PORT=8080
SPIDER_DATA_DIR=data
